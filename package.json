{
  "name": "lead-magnet-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:ci": "vitest run --reporter=json --outputFile=reports/unit-results.json",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:ci": "vitest run --config vitest.integration.config.mts --reporter=json --outputFile=reports/integration-results.json",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:deployment:smoke": "node scripts/deployment/smoke.mjs",
    "backfill:template-copy": "node scripts/backfill-template-copy-defaults.mjs",
    "test:policy": "node --test .github/scripts/pr-policy.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "parse5": "^8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-dist": "^5.32.15"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "4.21.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
